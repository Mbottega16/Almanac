# SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./data/almanac.db

# Auth gate (Phase 5) — set once the auth gate is built, before deploying.
# Until then the app is wide open; don't deploy without these.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Live Claude-assisted capture (Phase 7) — leave blank until explicitly approved.
# Everything that would call this is built and tested with the call mocked out;
# it only activates once a real key is dropped in here.
ANTHROPIC_API_KEY=
